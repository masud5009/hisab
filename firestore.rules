// ============================================================
// firestore.rules
// Copy-paste this into Firebase Console → Firestore → Rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: check if the requester is an admin ───────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Helper: check if the requester is a specific user ──
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ─── users collection ─────────────────────────────────
    match /users/{userId} {
      // Authenticated members can read member profiles for shared calculation counts.
      allow read: if request.auth != null;
      // Only admins can create or update user profiles
      allow create, update, delete: if isAdmin();
    }

    // ─── bazar collection ──────────────────────────────────
    match /bazar/{docId} {
      // Authenticated members can read monthly bazar totals for meal-rate calculation.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (request.auth != null &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    // ─── meals collection ──────────────────────────────────
    match /meals/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (request.auth != null &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }


    // ─── months collection ─────────────────────────────────
    match /months/{monthId} {
      // All authenticated users can READ month cost data (needed for their own calculation)
      allow read: if request.auth != null;
      // Only admin can write month costs
      allow write: if isAdmin();
    }

    // ─── rentSplits collection ─────────────────────────────
    match /rentSplits/{docId} {
      // User can read their own rent split; admin can read/write all
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ─── additionalCosts collection ────────────────────────
    match /additionalCosts/{docId} {
      // All authenticated members can read additional costs
      allow read: if request.auth != null;
      // Only admins can create, update, or delete additional costs
      allow write: if isAdmin();
    }
  }
}
